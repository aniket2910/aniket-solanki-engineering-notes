{
  "name": "interview-prep-revise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Revision notes for technical interviews: one page per problem or concept, with the explanation an interviewer expects, hidden answers, a code runner and a practice heatmap.",
  "scripts": {
    "dev": "vite --port 5190",
    "build": "tsc && vite build",
    "preview": "vite preview --port 5190",
    "check": "node --experimental-strip-types --no-warnings scripts/check-content.ts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@uiw/react-codemirror": "4.23.0",
    "marked": "12.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sucrase": "3.35.1"
  },
  "devDependencies": {
    "@types/node": "22.7.4",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "typescript": "5.5.3",
    "vite": "5.4.0"
  }
}
