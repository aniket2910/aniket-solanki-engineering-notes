{
  "name": "interview-prep-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "One reading-and-practice app for the whole INTERVIEW_PREP notebook. Subjects (Postgres, React, DSA) are tabs; content is read straight from the subject folders' markdown, so the notes stay the single source of truth.",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check:sql50": "node --experimental-strip-types --no-warnings scripts/check-sql50.ts"
  },
  "dependencies": {
    "@codemirror/lang-sql": "6.7.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@electric-sql/pglite": "0.5.8",
    "@uiw/react-codemirror": "4.23.0",
    "marked": "12.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.7.4",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "typescript": "5.5.3",
    "vite": "5.4.0"
  }
}
